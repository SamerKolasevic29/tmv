# tmv.env - rules for the tmv timer
#
# Rules (checked by `tmv -t`):
#   1. The first line (not counting comments/blanks) is TARGET_DIR.
#   2. Every TARGET_FILES is directly followed by its DIR_NAME.
#   3. The file ends with a DIR_NAME.
#
# TARGET_FILES is a preset (--video-files, --music-files, --images-files,
# --docs-files, --archives-files) or a glob ("*.iso").
# DIR_NAME is a plain folder name created inside TARGET_DIR (no '/').
# If a file matches several rules, the first rule wins.
# No inline comments after values. This file is parsed, never sourced.

TARGET_DIR="$HOME/Downloads"

TARGET_FILES="--video-files"
DIR_NAME="Videos"

TARGET_FILES="--music-files"
DIR_NAME="Music"

TARGET_FILES="--images-files"
DIR_NAME="Images"

TARGET_FILES="--docs-files"
DIR_NAME="Documents"

TARGET_FILES="--archives-files"
DIR_NAME="Archives"

TARGET_FILES="*.iso"
DIR_NAME="ISO"
